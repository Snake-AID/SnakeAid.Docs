/* SnakeAid Unified ERD (DBML) */

Enum ai_recognition_doc_type {
  SNAKEBITE_INCIDENT
  COMMUNITY_REPORT
  SNAKE_CATCHING_REQUEST
}

Table ACCOUNT [headercolor: #FFD700] {
  id uuid [pk]
  full_name varchar
  email varchar
  phone varchar
  role varchar
  status varchar
  is_active boolean [default: true]
  created_at timestamptz
  updated_at timestamptz

  Indexes {
    (email) [unique]
    (phone) [unique]
  }

  Note: '''
  Bảng tài khoản chung cho tất cả người dùng:
  - Lưu thông tin cơ bản: tên, email, điện thoại, vai trò (member, rescuer, expert).
  - Quản lý trạng thái và số dư ví.
  '''
}

Table WALLET {
  id uuid [pk]
  wallet_balance numeric [default: 0]  // Số dư ví
  wallet_currency varchar [default: 'VND']  // Tiền tệ
  created_at timestamptz
  updated_at timestamptz

  account_id uuid [not null, unique, ref: > ACCOUNT.id]

  Note: '''
  Bảng ví riêng biệt (nếu cần tách ví ra khỏi accounts):
  - Quản lý số dư ví và tiền tệ.
  '''
}

Table WALLET_WITHDRAW {
  id uuid [pk]
  amount numeric [not null]
  currency varchar [not null, default: 'VND']
  status varchar [not null, default: 'PENDING']  // PENDING | COMPLETED | REJECTED
  created_at timestamptz
  updated_at timestamptz

  wallet_id uuid [not null, ref: > WALLET.id]

  Note: '''
  Bảng ví riêng biệt (nếu cần tách ví ra khỏi accounts):
  - Quản lý số dư ví và tiền tệ.
  '''
}

Table MEMBER_PROFILE [headercolor: #FFA500] {
  account_id uuid [pk, not null, unique, ref: > ACCOUNT.id]
  emergency_contact varchar
  rating_avg numeric [default: 0, note: "Average rating from rescuers/experts (for bad behavior)"]
  rating_count int [default: 0, note: "Number of ratings from rescuers/experts"]

  Note: '''
  Profile cho member (người dùng cuối):
  - Lưu thông tin liên hệ khẩn cấp.
  - Thêm rating_avg/rating_count để track reputation dựa trên feedback NEGATIVE từ rescuer/expert (e.g., đặt đơn bậy, quấy rối).
  - Dùng để cảnh báo hoặc blacklist member có hành vi xấu.
  '''
}

Table RESCUER_PROFILE [headercolor: #FFA500] {
  account_id uuid [pk, not null, unique, ref: > ACCOUNT.id]
  bio text
  is_available boolean [default: false, note: "account toggles Open/Close; realtime presence still handled in Redis"]
  last_open_at timestamptz
  rating_avg numeric
  rating_count int
  rescuer_type varchar [not null, default: 'BOTH', note: "SOS: Chuyên sơ cứu, REMOVAL: Chuyên dọn rắn, BOTH: Cả hai"]

  Note: '''
  Profile cho rescuer (người cứu hộ):
  - Lưu thông tin chuyên môn và trạng thái sẵn sàng.
  - Thêm rescuer_type để phân loại chuyên môn (SOS, REMOVAL, BOTH).
  - Dùng để lọc và ưu tiên khi dispatch nhiệm vụ cứu hộ.
  '''
}

Table EXPERT_PROFILE [headercolor: #FFA500] {
  account_id uuid [pk, not null, unique, ref: > ACCOUNT.id]
  specialization_id uuid [not null, ref: > SPECIALIZATION.id]
  bio text
  rating_avg numeric [default: 0, note: "Average rating from consultations"]
  rating_count int [default: 0, note: "Number of ratings from consultations"]
  experience_count int [default: 0, note: "Number of consultations completed"]

  Note: '''
  Profile cho expert (chuyên gia tư vấn):
  - Lưu thông tin chuyên môn và xác minh.
  - Thêm rating_avg/rating_count để tính reputation dựa trên feedback POSITIVE từ member sau consultation.
  - Dùng để hiển thị uy tín expert, ưu tiên expert có rating cao.
  '''
}

Table EXPERT_CERTIFICATE {
  id uuid [pk]
  expert_id uuid [not null, ref: > EXPERT_PROFILE.account_id]
  
  certificate_name varchar(255) [not null, note: "Tên chứng chỉ"]
  certificate_number varchar(255) [not null, note: "Số hiệu chứng chỉ"]
  issued_by varchar(255) [not null, note: "Tổ chức cấp"]
  issued_date date [not null]
  expiry_date date [note: "Ngày hết hạn"]
  
  file_url text [note: "URL file upload (PDF/jpg)"]
  status varchar(24) [not null, default: "PENDING", note: "PENDING | APPROVED | REJECTED"]
  rejection_reason text [note: "Lý do reject nếu có"]
  
  reviewed_by uuid [note: "Admin duyệt"]
  reviewed_at timestamptz
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  Indexes {
    (expert_id, status)  // Query nhanh chứng chỉ approved của expert để view
  }
  
  Note: '''
  Chứng chỉ hành nghề của expert:
  - Expert upload/cập nhật (status PENDING).
  - Admin duyệt (APPROVED/REJECTED).
  - Chỉ APPROVED mới hiển thị trên profile view.
  Không hỗ trợ search theo chứng chỉ.
  '''
}

Table SYSTEM_EVENT {
  id uuid [pk]
  event_type varchar
  actor_id uuid [ref: > ACCOUNT.id]
  actor_role varchar
  ref_type varchar
  ref_id uuid
  metadata jsonb
  created_at timestamptz

  Indexes {
    (event_type, created_at)
    (actor_id, created_at)
  }

  Note: '''
  Bảng log sự kiện hệ thống:
  - Lưu trữ các hành động quan trọng của người dùng (đăng nhập, cập nhật profile, tạo request).
  - Dùng để audit và phân tích hành vi người dùng.
  '''
}

Table APP_NOTIFICATION {
  id uuid [pk]
  account_id uuid [not null, ref: > ACCOUNT.id]
  title varchar(255)
  body text
  payload_json jsonb
  is_read boolean [default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, is_read, created_at)
  }
}

Table PAYMENT_CARD {
  id uuid [pk]
  account_id uuid [not null, ref: > ACCOUNT.id]
  method_type varchar(16) [not null, default: 'CARD', note: "CARD | EWALLET | BANK_TRANSFER"]  // Phân biệt loại
  provider varchar(32) [not null, note: "e.g., Visa, Mastercard, Grab, Shopee, VNPay"]  // Nhà cung cấp
  identifier varchar(255) [not null, note: "Mã hóa: card_number (last 4 digits), e-wallet ID, hoặc bank account"]  // Không lưu full sensitive data
  expiry_date date [note: "Cho card; null cho e-wallet"]
  card_holder_name varchar(255) [note: "Cho card; mã hóa nếu cần"]
  is_default boolean [default: false, note: "Phương thức mặc định"]
  is_active boolean [default: true, note: "Active/inactive"]
  status varchar(24) [default: 'VERIFIED', note: "PENDING | VERIFIED | FAILED | EXPIRED"]  // Trạng thái xác minh
  metadata jsonb [note: "Chi tiết bổ sung: e.g., {'bank_code': 'VCB', 'wallet_balance': 100000}"]  // Flexible cho e-wallet
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, is_default)  // Query nhanh default method
    (account_id, is_active)
  }

  Note: '''
  Lưu phương thức thanh toán linked (card, e-wallet, bank):
  - identifier: Lưu hashed/encrypted (không plain text) để bảo mật PCI DSS.
  - method_type/provider: Hỗ trợ đa dạng (card vật lý, e-wallet như Grab/Shopee).
  - is_default: Chọn method mặc định cho nạp tiền.
  - status: Xác minh qua gateway (e.g., tokenization).
  - Không lưu CVV/full card number; dùng token từ payment gateway.
  '''
}

Table SPECIALIZATION {
  id uuid [pk]
  name varchar(64) [not null, unique, note: "e.g., Neurotoxic, Hemotoxic, Cytotoxic, Myotoxic"]
  description text [note: "Description of specialization"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Các chuyên môn chính của chuyên gia
  - Liên quan đến các loại độc tố rắn.
  - Hoặc các kỹ năng tư vấn sơ cứu cụ thể.
  - Dùng để gán chuyên gia theo kỹ năng.
  '''
}

Table VENOM_TYPES {
  id uuid [pk]
  name varchar(64) [not null, unique, note: "e.g., Neurotoxic, Hemotoxic, Cytotoxic, Myotoxic"]
  priority int [not null, default: 0, note: "Higher priority = more dangerous, used for fallback logic"]
  description text [note: "Description of venom effects"]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Các loại độc tố chính của rắn:
  - Neurotoxic: Gây liệt thần kinh.
  - Hemotoxic: Gây rối loạn đông máu.
  - Cytotoxic: Gây hoại tử mô.
  - Myotoxic: Gây tiêu cơ.
  - Priority để quyết định guideline fallback.
  '''
}

Table SPECIES_VENOM {
  species_id uuid [not null, ref: > SNAKE_SPECIES.id]
  venom_type_id uuid [not null, ref: > VENOM_TYPES.id]

  Indexes {
    (species_id, venom_type_id) [pk]
    (venom_type_id)
  }
}

Table SNAKE_SPECIES {
  id uuid [pk]
  slug varchar(120) [not null, unique, note: "Stable identifier, e.g. cap_nia_bac, ran_rao_trau"]

  scientific_name varchar(255) [unique, note: "e.g. Naja kaouthia"]
  common_name_default varchar(255) [note: "Default display name"]

  venomous_level varchar(32) [not null, note: "NON_VENOMOUS | MILD | MEDIUM | HIGH | UNKNOWN"]
  primary_venom_type varchar(64) [note: "Main venom type for quick lookup, ref venom_types.name"]
  risk_priority int [not null, default: 0, note: "Higher = more prominent warning/priority"]

  status varchar(24) [not null, default: "DRAFT", note: "DRAFT | REVIEWING | PUBLISHED | ARCHIVED"]
  is_active boolean [not null, default: true]

  identification_summary text [note: "Summary for identification"]
  key_features jsonb [note: "Key features in JSON"]
  similar_species_notes text [note: "Notes on similar species"]
  identification_updated_at timestamptz [not null, default: `now()`, note: "Last update for identification data"]

  firstaid_guildeline_override jsonb [note: "Override first aid guideline JSON if needed"]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
}

Table SNAKE_SPECIES_NAMES {
  id uuid [pk]
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]

  language_code varchar(10) [not null]
  name varchar(255) [not null]
  name_type varchar(24) [not null, default: "COMMON", note: "COMMON | LOCAL | ALIAS | MISSPELLING"]
  is_primary boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (snake_species_id, language_code)
    (snake_species_id, language_code, name) [unique]
  }
}

Table LIBRARY_MEDIA {
  id uuid [pk]
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]

  media_type varchar(16) [not null, note: "IMAGE | VIDEO"]
  url text [not null]
  caption varchar(255)
  source varchar(255)

  usage varchar(24) [not null, default: "LIBRARY", note: "LIBRARY | TRAINING | VERIFICATION"]
  is_primary boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (snake_species_id, usage)
  }

  Note: '''
  Media thư viện loài rắn (content tĩnh cho app):
  - Ảnh/video mẫu của rắn để account đọc thông tin, học tập.
  - Sử dụng cho LIBRARY, TRAINING, VERIFICATION.
  Không liên quan đến account reports.
  '''
}


Table FIRST_AID_GUIDELINES {
  id uuid [pk]
  target_type varchar(24) [not null, note: "COMBINATION | GENERAL"]
  target_id varchar(255) [not null, note: "combo key like 'CYTO_NEURO' for COMBINATION, venom_type name for GENERAL"]
  venom_type_id uuid [ref: > VENOM_TYPES.id, note: "Direct link for GENERAL guideline (1:1 with venom_types)"]

  content_json jsonb [not null, note: "do_list, dont_list, visuals, etc."]

  version int [not null, default: 1]
  is_published boolean [not null, default: false]
  published_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Indexes {
    (target_type, target_id, version) [unique]
    (venom_type_id) [unique]
    (target_type, is_published)
  }

  Note: '''
  Kho hướng dẫn sơ cứu thông minh:
  - target_type: COMBINATION (tổ hợp độc), GENERAL (chung cho loại độc).
  - Logic: Ưu tiên SPECIES → COMBINATION → GENERAL dựa trên venom_types của loài.
  - content_json: Rich data cho UI (bước làm, không làm, hình ảnh).
  '''
}

Table SNAKE_DISTRIBUTION {
  id uuid [pk]
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]

  distribution_geometry geography [note: "PostGIS: geography(MultiPolygon,4326) for range map display and geofencing"]
  source varchar(255) [note: "Data source: e.g., IUCN, expert mapping, literature"]
  confidence int [not null, default: 50, note: "Confidence level 0-100"]
  notes text

  version int [not null, default: 1]
  is_active boolean [not null, default: true]

  // For geofencing notifications
  geofence_enabled boolean [not null, default: true, note: "Enable geofence alerts for this distribution"]
  alert_message_template text [note: "Template for notification: e.g., 'Bạn đang ở khu vực {region} có loài rắn nguy hiểm: {species_list}'"]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  Indexes {
    (snake_species_id)
    (distribution_geometry)  // Spatial index for map queries and geofencing
    (geofence_enabled, is_active)  // For efficient geofence queries
  }

  Note: '''
  Phân bố địa lý của loài rắn:
  - distribution_geometry: Polygons cho bản đồ range map và geofencing (check account location).
  - geofence_enabled/alert_message_template: Hỗ trợ notification cảnh báo khi account vào vùng nguy hiểm.
  - Confidence: Độ tin cậy của data.
  - Version: Hỗ trợ update distribution over time.
  - Dùng để hiển thị bản đồ, filter loài, validate reports, và trigger alerts.
  '''
}

Table ANTIVENOM {
  id uuid [pk]
  name varchar(255) [not null, unique]
  manufacturer varchar(255)
  description text
  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table SNAKE_SPECIES_ANTIVENOM {
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]
  antivenom_id uuid [not null, ref: > ANTIVENOM.id]

  Indexes {
    (snake_species_id, antivenom_id) [pk]
    (antivenom_id)
  }
}

Table AI_MODEL {
  id uuid [pk]
  name varchar(255) [not null]
  version_tag varchar(64) [not null]
  nc int [not null]
  is_active boolean [not null, default: true]

  trained_at timestamptz
  notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (name, version_tag) [unique]
  }
}

Table AI_MODEL_CLASS_MAP {
  id uuid [pk]
  ai_model_id uuid [not null, ref: > AI_MODEL.id]

  class_id int [not null]
  class_label varchar(120) [not null]
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]

  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (ai_model_id, class_id) [unique]
    (ai_model_id, class_label)
    (snake_species_id)
  }
}

Enum snakebite_incident_status {
  PENDING
  PROCESSING
  EN_ROUTE
  RESCUER_ARRIVED
  MEDICAL_PROCESSING
  HOSPITAL_TRANSPORTING
  HOSPITAL_ARRIVED
  AWAITING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  NO_RESCUER_FOUND
  DISPUTE
}

Table SNAKEBITE_INCIDENT [headercolor: #07ae07] {
  id uuid [pk]
  status snakebite_incident_status [default: 'PENDING']
  member_id uuid [not null, ref: > MEMBER_PROFILE.account_id]
  snake_species_id uuid [ref: > SNAKE_SPECIES.id]
  symptoms jsonb [note: "Array of selected symptoms with severity points, e.g., [{'symptom': 'SWELLING', 'severity_points': 3}, {'symptom': 'NAUSEA', 'severity_points': 2}]"]
  severity_score int [note: "Calculated severity score from symptoms, used for prioritization and guideline fallback"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (member_id, created_at)
    (severity_score)
  }

  Note: '''
  Bảng incident cho snakebite (SOS flow):
  - symptoms: JSONB chứa danh sách triệu chứng đã chọn với điểm severity từ symptom_config.
  - severity_score: Tổng điểm tính từ symptoms, dùng để ưu tiên và fallback guideline.
  - Tách riêng cho SOS, không dùng cho community_alert hay snake_catching_request.
  '''
}

Table CATCHING_REQUEST_DETAIL {
  id uuid [pk]
  catching_request_id uuid [not null, ref: > SNAKE_CATCHING_REQUEST.id]  // Thay removal_request_id thành catching_request_id
  species_id uuid [not null, ref: > SNAKE_SPECIES.id]  // Giống loài khai báo
  declared_size varchar [not null, note: "Kích thước ước tính của rắn"]
  declared_quantity int [not null]  // Số lượng khai báo cho loài này
  notes text  // Ghi chú bổ sung từ người dùng
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (catching_request_id, species_id, declared_size) [unique]  // Một request không khai báo trùng loài và kích thước
  }

  Note: 'Lưu trữ khai báo của người dùng cho yêu cầu bắt rắn, bao gồm ước tính loài, kích thước và số lượng.'
}

Enum snake_catching_request_status {
  PENDING
  PROCESSING
  EN_ROUTE
  RESCUER_ARRIVED
  MEDICAL_PROCESSING
  HOSPITAL_TRANSPORTING
  HOSPITAL_ARRIVED
  AWAITING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  NO_RESCUER_FOUND
  DISPUTE
}

Table SNAKE_CATCHING_REQUEST [headercolor: #07ae07] {
  id uuid [pk]
  member_id uuid [not null, ref: > MEMBER_PROFILE.account_id]  // Người tạo request
  location geography [note: "PostGIS: geography(Point,4326), vị trí bắt rắn"]
  address_text varchar  // Địa chỉ text
  status snake_catching_request_status [default: 'PENDING']
  priority int [default: 0, note: "Ưu tiên dựa trên severity, loại rắn"]
  created_at timestamptz [not null, default: `now()`]
  accepted_at timestamptz  // Khi rescuer accept
  completed_at timestamptz  // Khi hoàn thành

  Note: '''
  Bảng riêng cho catching requests:
  - account tạo trực tiếp vào đây, không qua rescue_request.
  - Vào queue để rescuer duyệt và accept.
  - Khi accept, tạo snake_catching_mission.
  '''
}

Enum snake_catching_mission_status {
  PREPARING
  EN_ROUTE
  RESCUER_ARRIVED
  MISSION_COMPLETED
  MISSION_UNCOMPLETED
  MISSION_ABORT
  CANCELLED
}

Table SNAKE_CATCHING_MISSION [headercolor: #07ae07] {
  id uuid [pk]
  catching_request_id uuid [not null, ref: > SNAKE_CATCHING_REQUEST.id]
  rescuer_id uuid [not null, ref: > RESCUER_PROFILE.account_id]
  status snake_catching_mission_status [default: 'PREPARING']
  created_at timestamptz [not null, default: `now()`]
  accepted_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz

  Indexes {
    (catching_request_id)
    (rescuer_id, status)
  }
}

Table SNAKE_CATCHING_DETAIL {
  id uuid [pk]
  snake_catching_mission_id uuid [not null, ref: > SNAKE_CATCHING_MISSION.id]
  species_id uuid [not null]  // Loài thực tế
  actual_size varchar [not null, note: "Kích thước thực tế của rắn"]
  actual_quantity int [not null]  // Số lượng thực tế (cập nhật từ declarations)
  notes text  // Ghi chú từ rescuer (e.g., lý do khác biệt)
  reported_by uuid   // Rescuer report
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (snake_catching_mission_id, species_id, actual_size)
  }

  Note: '''
  Báo cáo số lượng thực tế riêng cho catching:
  - Báo cáo số lượng và kích thước thực tế từ rescuer, tách riêng để tránh lẫn với SOS.
  - Link trực tiếp với declarations để cập nhật actual, tính toán pricing chính xác dựa trên tariffs.
  '''
}

Table COMMUNITY_REPORT [headercolor: #07ae07] {
  id uuid [pk]
  member_id uuid [ref: > MEMBER_PROFILE.account_id]  // Optional, anonymous
  snake_species_id uuid 
  location geography [note: "PostGIS: geography(Point,4326), vị trí phát hiện"]
  description text  // Mô tả từ reporter
  severity_score int [note: "Chấm điểm nguy hiểm từ AI"]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
  Bảng riêng cho community reports:
  - Báo cáo phát hiện rắn ở khu vực công cộng, để cảnh báo cộng đồng và heatmap.
  - Không liên quan đến SOS cá nhân hay removal.
  '''
}

Enum rescue_request_status {
  PENDING
  RESCUER_ACCEPTED
  TAKEN
  CANCELLED
  EXPIRED
}

Table RESCUE_REQUEST [headercolor: #07ae07] {
  id uuid [pk]
  incident_id uuid [ref: > SNAKEBITE_INCIDENT.id]  // Cho SOS
  request_type varchar [not null, default: 'SOS']  // Chỉ SOS
  rescuer_id uuid [ref: > RESCUER_PROFILE.account_id]
  status rescue_request_status [default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]

  // Gộp từ map.incidents cho SOS
  location geography [note: "PostGIS: geography(Point,4326), gộp từ map.incidents"]
  geohash varchar [note: "Optional: for coarse partitioning/analytics"]
  address_text varchar
  severity int [note: "0-5 or your own scale, gộp từ map.incidents"]
  incident_notes text [note: "Gộp từ map.incidents.notes"]

  Note: '''
  Bảng chỉ cho SOS requests (realtime matching):
  - SOS: Gọi đội sơ cứu + di chuyển bệnh viện, thêm location/severity từ incidents.
  - Không dùng cho removal (removal dùng removal_request riêng).
  '''
}

Table SNAKE_AI_RECOGNITION_RESULT {
  id uuid [pk]
  doc_no uuid [not null]  // ID của document (thay report_id)
  doc_type ai_recognition_doc_type [not null]  // Loại document
  media_id uuid [not null, ref: > REPORT_MEDIA.id]
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]
  ai_model_id uuid [ref: > AI_MODEL.id, note: "Model AI used for recognition"]
  ai_results jsonb  // Kết quả AI: top predictions, confidence, etc.
  processed_at timestamptz [not null, default: `now()`, note: "Timestamp when AI processed"]
  status varchar(24) [not null, default: 'PROCESSED', note: "PROCESSED | FAILED"]

  // Thêm fields cho expert review
  expert_reviewed_by uuid [ref: > EXPERT_PROFILE.account_id]  // Expert review
  expert_corrected_species_id uuid [ref: > SNAKE_SPECIES.id]  // Species corrected by expert
  expert_confirmed_at timestamptz  // Timestamp khi expert confirm

  Indexes {
    (doc_no, doc_type) [unique]  // Thay (report_id) để đảm bảo 1 document có 1 recognition
    (media_id) [unique]
    (snake_species_id)
  }

  Note: '''
  Liên kết AI recognition với documents qua doc_no và doc_type (giống payment_transaction):
  - Giảm ref trực tiếp, hỗ trợ nhiều loại document (SOS, community, incident).
  - Lưu ai_results (JSON): top predictions, confidence scores, severity.
  - ai_model_id/processed_at/status: Metadata của phiên AI.
  - Expert review: Correct species nếu AI sai, dùng để train model mới.
  '''
}

Enum rescue_mission_status {
  PREPARING
  EN_ROUTE
  RESCUER_ARRIVED
  MISSION_COMPLETED
  MISSION_UNCOMPLETED
  MISSION_ABORT
  CANCELLED
}

Table RESCUE_MISSION [headercolor: #07ae07] {
  id uuid [pk]
  request_id uuid [ref: > RESCUE_REQUEST.id]  // Cho SOS
  rescuer_id uuid [not null, ref: > RESCUER_PROFILE.account_id]

  // Gộp từ map.rescue_sessions
  member_id uuid 
  assigned_rescuer_id uuid [null]  // Có thể khác rescuer_id nếu reassign
  status rescue_mission_status [default: 'PREPARING']
  location geography [note: "PostGIS: geography(Point,4326)"]
  address_text varchar
  created_at timestamptz [not null, default: `now()`]
  accepted_at timestamptz
  started_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancel_reason varchar
  route_polyline text [note: "Optional; store if you compute ETA/route server-side"]

  Indexes {
    (request_id) [unique]
    (assigned_rescuer_id, status)
    (status, created_at)
  }

  Note: '''
  Bảng mission cứu hộ (dành riêng cho luồng SOS):
  - Quản lý dispatch, status, timings, offers.
  - Location events và notifications tách riêng (map.location_events, map.notification_log) để refactor sau.
  - Một mission có thể từ SOS (request_id).
  '''
}

Table RESCUE_TRACKING {
  id uuid [pk]
  rescue_mission_id uuid [not null, ref: > RESCUE_MISSION.id]
}

Table RESCUE_TOOLS {
  id uuid [pk]
  content jsonb
}

Table SAFETY_GUIDELINES {
  id uuid [pk]
  content jsonb
}

Table CATCHING_ENVIRONMENT {
  id uuid [pk]
  snake_catching_mission_id uuid [not null]

  Note: 'Ghi lại các điều kiện cụ thể của nhiệm vụ cứu hộ (ví dụ: địa hình, thời tiết, độ khó) ảnh hưởng đến định giá và thực hiện.'
}

Table SNAKE_CATCHING_TARIFF {
  id uuid [pk]
  catching_environment_id uuid [not null]
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]
  size_category varchar [not null, note: "Kích thước rắn: SMALL (<1m), MEDIUM (1-2m), LARGE (>2m)"]
  base_price numeric [not null, note: "Giá cơ bản cho kích thước này, VND"]
  multiplier numeric [default: 1.0, note: "Hệ số nhân dựa trên điều kiện (e.g., địa hình hiểm trở = 1.5)"]

  Indexes {
    (snake_species_id, size_category)
    (catching_environment_id)
  }

  Note: 'Xác định quy tắc định giá cho việc diệt rắn dựa trên loài, kích thước và điều kiện cứu hộ. Giá tính = base_price * multiplier.'
}

Table REVENUE_SHARE {
  id uuid [pk]
  content jsonb

  Note: 'Cấu hình tỷ lệ chia sẻ doanh thu cho thanh toán (ví dụ: phí nền tảng, phần của người cứu hộ, phần của chuyên gia).'
}

Enum consultation_status {
  SCHEDULED
  ONGOING
  COMPLETED
  USER_ABSENT
  EXPERT_ABSENT
  ALL_ABSENT
  CANCELLED
}

Table CONSULTATION [headercolor: #07ae07] {
  id uuid [pk]
  member_id uuid [ref: > MEMBER_PROFILE.account_id]
  rescuer_id uuid [ref: > RESCUER_PROFILE.account_id]
  expert_id uuid [not null, ref: > EXPERT_PROFILE.account_id]
  incident_id uuid 
  expert_time_slot_id uuid [not null, unique, ref: > EXPERT_TIME_SLOT.id]
  consultation_booking_id uuid [not null, unique, ref: > CONSULTATION_BOOKING.id]
  call_type varchar(16) [not null, default: 'VIDEO', note: "VIDEO | AUDIO"]
  status consultation_status [not null, default: 'SCHEDULED']
  room_id varchar(255) [note: "WebRTC room ID"]
  start_time timestamptz
  end_time timestamptz
  duration_seconds int
  metadata jsonb [note: "Flexible data: e.g., {'platform': 'webrtc', 'stun_servers': [...]}"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (expert_id)
    (incident_id)
    (status, start_time)
  }

  Note: '''
  Bảng session tư vấn với call video/audio qua WebRTC:
  - Kết hợp consultation và call_session thành một session duy nhất cho buổi tư vấn.
  - room_id: WebRTC room ID để join call.
  - metadata: Config WebRTC (stun_servers, etc.).
  - Participants track qua call_participant (hỗ trợ 1-1 hoặc multi-party).
  - Không hỗ trợ retry nhiều sessions; mỗi consultation là duy nhất.
  '''
}

Table CHAT_MESSAGE {
  id uuid [pk]
  consultation_id uuid [not null, ref: > CONSULTATION.id]
  sender_id uuid [not null, ref: > ACCOUNT.id]
  receiver_id uuid [ref: > ACCOUNT.id, null]  // Null cho public chat
  message_type varchar(16) [not null, default: 'TEXT', note: "TEXT | FILE | IMAGE"]
  content text [not null]  // Text hoặc URL nếu file
  timestamp timestamptz [not null, default: `now()`]
  is_deleted boolean [default: false]

  Indexes {
    (consultation_id, timestamp)
    (sender_id)
  }

  Note: '''
  Chat trong call (như Zoom):
  - Lưu history tin nhắn realtime.
  - Hỗ trợ private/public chat.
  - Không trùng với consultation_note (đó là ghi chú sau).
  '''
}

Enum expert_time_slot_status {
  AVAILABLE
  BOOKED
  CANCELLED
}

Table EXPERT_TIME_SLOT {
  id uuid [pk]
  expert_id uuid [not null, ref: > EXPERT_PROFILE.account_id]
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  status expert_time_slot_status [default: "AVAILABLE"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (expert_id, start_time)
  }
}

Enum consultation_booking_status {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  REFUNDED
  CANCELLED
  EXPIRED
}

Table CONSULTATION_BOOKING [headercolor: #07ae07] {
  id uuid [pk]
  member_id uuid [not null, ref: > MEMBER_PROFILE.account_id]
  expert_time_slot_id uuid [not null, unique, ref: > EXPERT_TIME_SLOT.id]
  status consultation_booking_status [default: "PENDING_PAYMENT"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (member_id, created_at)
  }
}

Enum consultation_ping_request_status {
  PENDING_EXPERT_ACCEPT
  EXPERT_ACCEPTED
  REJECTED_BY_EXPERT
  CANCELLED_BY_RESCUER
  EXPIRED
}

Table CONSULTATION_PING_REQUEST [headercolor: #07ae07] {
  id uuid [pk]
  consultation_id uuid [not null, ref: > CONSULTATION.id]
  rescue_mission_id uuid [ref: > RESCUE_MISSION.id]
  rescuer_id uuid [ref: > RESCUER_PROFILE.account_id]
  expert_id uuid [ref: > EXPERT_PROFILE.account_id]
  status consultation_ping_request_status [default: "PENDING_EXPERT_ACCEPT"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (consultation_id, created_at)
    (rescuer_id, created_at)
    (expert_id, created_at)
  }
}

Table USER_FEEDBACK {
  id uuid [pk]
  member_rater_id uuid [ref: > MEMBER_PROFILE.account_id]  // Member rate
  member_target_id uuid [ref: > MEMBER_PROFILE.account_id] // Member bi rate
  rescuer_id uuid [ref: > RESCUER_PROFILE.account_id]
  expert_rater_id uuid [ref: > EXPERT_PROFILE.account_id]
  expert_target_id uuid [ref: > EXPERT_PROFILE.account_id]
  rater_role varchar [not null]                 // Role của người rate
  target_role varchar [not null]                // Role của người bị rate
  rescue_mission_id uuid [ref: > RESCUE_MISSION.id] // Liên kết mission
  snake_catching_mission_id uuid [ref: > SNAKE_CATCHING_MISSION.id] // Liên kết catching mission
  consultation_id uuid [ref: > CONSULTATION.id]     // Liên kết consultation
  feedback_type varchar [not null]           // POSITIVE (member rate rescuer/expert) or NEGATIVE (rescuer/expert rate member)
  score int [note: "Rating score 1-5 (higher for positive, lower for negative)"]
  comment text [note: "Feedback text"]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
  Bảng feedback và rating bidirectional (hai chiều):
  - POSITIVE: member rate rescuer/expert sau mission/consultation để đánh giá dịch vụ.
  - NEGATIVE: Rescuer/expert rate member nếu có hành vi xấu (đặt đơn bậy, quấy rối) để track reputation.
  - Dùng để tính rating_avg/rating_count cho từng role, hỗ trợ uy tín và quản lý hành vi.
  '''
}

Table REPUTATION_RAW_EVENT {
  id uuid [pk]
  account_id uuid [not null, ref: > ACCOUNT.id]  // account bị ảnh hưởng (member, rescuer, expert)
  event_type varchar [not null]             // Loại event: 'FEEDBACK_RECEIVED', 'MISSION_COMPLETED', 'CONSULTATION_FINISHED'
  ref_type varchar                           // Loại ref: 'FEEDBACK', 'MISSION', 'CONSULTATION'
  ref_id uuid                                // ID của feedback/mission/consultation
  points_change int                          // Điểm dự kiến thay đổi (có thể âm)
  metadata jsonb                             // Chi tiết bổ sung (e.g., score từ feedback)
  processed boolean [default: false]         // Đã qua engine chưa?
  created_at timestamptz [not null, default: `now()`]

  Note: '''
  Bảng lưu sự kiện thô (raw events) làm đầu vào thay đổi điểm uy tín:
  - Bao gồm rating lẫn nhau, hoàn thành mission/consultation.
  - Mục đích: Tránh người dùng lạm dụng app (e.g., đặt đơn bậy, quấy rối), bảo vệ nền tảng bằng cách track hành vi xấu.
  - Engine sẽ process để tính điểm chính xác.
  '''
}

Table REPUTATION_TRANSACTION {
  id uuid [pk]
  account_id uuid [not null, ref: > ACCOUNT.id]    // account bị thay đổi
  old_rating_avg numeric                      // Giá trị cũ
  new_rating_avg numeric                      // Giá trị mới
  points_added numeric                        // Điểm thực tế thêm/bớt
  triggered_by_raw_event_id uuid [unique, ref: > REPUTATION_RAW_EVENT.id]  // Liên kết với raw event
  created_at timestamptz [not null, default: `now()`]

  Note: '''
  Bảng lưu giao dịch thay đổi uy tín sau khi qua service engine:
  - Log lịch sử thay đổi rating_avg để audit và minh bạch.
  - Mục đích: Ngăn chặn lạm dụng app bằng cách giảm uy tín cho hành vi xấu (e.g., member quấy rối rescuer), bảo vệ nền tảng và người dùng tốt.
  - Dùng để hiển thị history uy tín cho account.
  '''
}

Table REPORT_MEDIA {
  id uuid [pk]
  media_type varchar  // Thay thế ref từ bảng media_type
  incident_id uuid [ref: > SNAKEBITE_INCIDENT.id]
  community_report_id uuid [ref: > COMMUNITY_REPORT.id]
  snake_catching_request_id uuid [ref: > SNAKE_CATCHING_REQUEST.id]
  snake_catching_mission_id uuid [ref: > SNAKE_CATCHING_MISSION.id]
  consultation_id uuid 
  rescue_mission_id uuid [ref: > RESCUE_MISSION.id]
  purpose varchar  // Mục đích media
  is_used_for_ai boolean [default: true]  // Ảnh có dùng cho AI nhận diện không?

  Note: '''
  Media từ account reports (ảnh/video):
  - INITIAL_DECLARATION: Khai báo ban đầu từ account (removal).
  - FINAL_PROOF: Bằng chứng sau từ rescuer (giống loài, số lượng thực tế để tính tiền).
  - IDENTIFICATION: Ảnh rắn để AI nhận diện loài và chấm điểm nguy hiểm.
  Liên kết với reports, incidents, consultations, missions.
  '''
}

Table TREATMENT_FACILITY {
  id uuid [pk]
  name varchar [not null]
  address text
  contact_number varchar
  position geography [note: "PostGIS: geography(Point,4326)"]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (is_active)
    (position)  // Spatial index for location-based queries
  }

  Note: '''
  Cơ sở y tế điều trị rắn cắn:
  - Lưu trữ thông tin cơ bản về các cơ sở y tế có khả năng điều trị rắn cắn.
  - Dùng để gợi ý chuyển viện trong quá trình tư vấn hoặc cứu hộ.
  '''
}

Table FACILITY_ANTIVENOM {
  facility_id uuid [not null, ref: > TREATMENT_FACILITY.id]
  antivenom_id uuid [not null, ref: > ANTIVENOM.id]

  Indexes {
    (facility_id, antivenom_id) [pk]
  }

  Note: '''
  Liên kết cơ sở y tế với antivenom có sẵn:
  - Giúp tư vấn viên và người cứu hộ biết được loại huyết thanh nào có sẵn tại cơ sở y tế.
  - Hỗ trợ quyết định chuyển viện dựa trên vị trí cơ sở y tế.
  '''
}

Table TRANSACTION {
  id uuid [pk]
  trans_date timestamptz [not null, default: `now()`]
  trans_type varchar [not null]
  doc_no uuid [not null]
  payment_method varchar [not null]
  account_id uuid [not null]
  account_role varchar [not null]
  amount numeric [not null]
  status varchar [default: 'PENDING', note: "PENDING | COMPLETED | FAILED | REFUNDED"]
  transaction_id varchar [note: "Unique ID từ payment gateway (e.g., VNPay transaction ID)"]
  gateway_response jsonb [note: "Chi tiết response từ gateway (e.g., error codes, metadata)"]
  processed_at timestamptz [note: "Timestamp khi transaction được xử lý"]

  Indexes {
    (account_id, trans_date)
    (status, trans_date)
  }

  Note: '''
  Bảng giao dịch thanh toán:
  - TransType xác định loại giao dịch.
  - DocNo là ID của document liên quan.
  '''
}

Table BLOG {
  id uuid [pk]
  expert_id uuid [not null, ref: > EXPERT_PROFILE.account_id, note: "Author (expert)"]
  title varchar [not null]
  slug varchar [not null, unique]
  content text [not null]
  is_published boolean [not null, default: false]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Bảng quản lý blog/articles:
  - Cho phép expert hoặc admin tạo nội dung chia sẻ kiến thức về rắn, phòng tránh rắn cắn, v.v.
  - Hỗ trợ trạng thái draft/published để quản lý xuất bản.
  - Nếu Expert tạo blog, thì admin sẽ duyệt trước khi publish.
  '''
}

Table FCM_DEVICE_TOKEN {
  id bigserial [pk]
  account_id uuid [ref: > ACCOUNT.id]
  platform varchar [note: "android | ios | web"]
  fcm_token varchar [unique]
  is_active boolean [default: true]
  last_seen_at timestamptz
  created_at timestamptz

  Indexes {
    (account_id, is_active)
    (last_seen_at)
  }

  Note: '''
  Device tokens để gửi push notifications qua FCM:
  - Lưu trữ token theo account và platform.
  - is_active để quản lý token còn hiệu lực.
  '''
}

Table MAP_LOCATION_EVENTS {
  id bigserial [pk]
  session_id uuid [ref: > RESCUE_MISSION.id]  // Đổi ref từ map.rescue_sessions sang rescue_mission
  account_id uuid 
  role varchar

  ts timestamptz
  geom geography [note: "PostGIS: geography(Point,4326)"]
  geohash varchar [note: "Optional; precompute if needed"]
  seq int [note: "Monotonic per account/session; helps de-dup/order"]
  source varchar

  speed_mps real
  heading_deg real
  accuracy_m real

  Indexes {
    (session_id, ts)
    (account_id, ts)
  }

  Note: '''
  Location events cho tracking realtime:
  - Chỉ insert events nếu rescue_mission.is_realtime_tracking = true (SOS flow).
  - Không dùng cho removal (queue-based, không tracking giữa member-rescuer).
  '''
}

Table MAP_NOTIFICATION_LOG {
  id bigserial [pk]
  account_id uuid 
  session_id uuid [ref: > RESCUE_MISSION.id, null]

  type varchar
  channel varchar

  title varchar
  body text
  payload_json jsonb

  provider_message_id varchar
  status varchar [note: "QUEUED | SENT | FAILED"]
  error text

  created_at timestamptz
  sent_at timestamptz

  Indexes {
    (account_id, created_at)
    (session_id, created_at)
    (type, created_at)
  }

  Note: '''
  Log notifications gửi qua hệ thống:
  - Ghi lại tất cả notifications (push, SMS, email) gửi đến account.
  - Bao gồm trạng thái gửi để theo dõi và debug.
  '''
}

Table FILTER_QUESTIONS {
  id uuid [pk]
  question_text text [not null, note: "Câu hỏi để lọc rắn, e.g., 'Màu sắc chính?'"]
  attribute_type varchar(32) [not null, note: "TEXT | SELECT | MULTISELECT"]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
  Danh mục câu hỏi để account lọc loài rắn khi AI không nhận diện được.
  Ví dụ: Màu sắc, kích thước, môi trường sống, etc.
  Không có confidence_score, chỉ là filter cơ bản.
  '''
}

Table ANSWER_OPTIONS {
  id uuid [pk]
  attribute_id uuid [not null, ref: > FILTER_QUESTIONS.id]
  option_text varchar(255) [not null, note: "Lựa chọn, e.g., 'Đen', 'Vàng'"]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (attribute_id)
  }

  Note: '''
  Các lựa chọn cho mỗi attribute (chỉ cho SELECT/MULTISELECT).
  account chọn từ danh sách để lọc step-by-step.
  '''
}

Table SPECIES_QUESTIONS_MAPPING {
  snake_species_id uuid [not null, ref: > SNAKE_SPECIES.id]
  attribute_id uuid [not null]
  option_id uuid [ref: > ANSWER_OPTIONS.id, note: "Optional nếu attribute là TEXT"]
  value_text text [note: "Nếu attribute là TEXT, lưu giá trị nhập"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (snake_species_id, attribute_id) [pk]
    (attribute_id)
  }

  Note: '''
  Liên kết loài rắn với attributes để hỗ trợ filtering.
  Cho phép account lọc loài dựa trên metadata khi AI fail.
  '''
}

Table SYMPTOM_CONFIG {
  id uuid [pk]
  venom_type_id uuid [not null, ref: > VENOM_TYPES.id]
  symptom_name varchar(255) [not null, unique, note: "Tên triệu chứng, e.g., 'Sưng', 'Buồn nôn'"]
  severity_points int [not null, default: 0, note: "Điểm severity cộng thêm khi có triệu chứng này"]
  description text [note: "Mô tả triệu chứng"]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Cấu hình triệu chứng và điểm severity:
  - Dùng để tính tổng điểm nguy hiểm trong SOS reports (snake_report.symptoms).
  - Admin quản lý để cập nhật điểm dựa trên chuyên môn.
  '''
}

Table REPUTATION_RULE {
  id uuid [pk]
  rule_type varchar(64) [not null, note: "Loại rule, e.g., 'BAD_BEHAVIOR', 'MISSION_CANCEL'"]
  points_deducted int [not null, note: "Điểm trừ uy tín (âm)"]
  description text [not null, note: "Mô tả rule"]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (rule_type, is_active)
  }

  Note: '''
  Cấu hình rules cho điểm trừ uy tín:
  - Dùng trong reputation_raw_event để tính points_change.
  - Admin cấu hình để xử lý sai phạm (e.g., patient quấy rối, rescuer bỏ mission).
  '''
}

// lesson table for rescuer training
Table LESSON {
  id uuid [pk]
  title varchar(255) [not null]
  description text
  content jsonb  // Nội dung khóa học (có thể là bài viết, video, quiz)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

